# Google Gemini API Key (Required for Spec Agent and SKiDL Agent)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Selection
SPEC_MODEL=gemini-2.5-flash
SKIDL_MODEL=gemini-2.5-flash

# KiCad Symbol Library Path (Customize according to your local KiCad installation)
# Example for Windows: D:\Kicad\share\kicad\symbols or C:\Program Files\KiCad\8.0\share\kicad\symbols
KICAD_SYMBOL_DIR=D:\Kicad\share\kicad\symbols
